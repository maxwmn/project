import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

#the datasets 3, 10, 17, 40, and 42 are the datasets for the turbine with asset_id = 10.

df3 = pd.read_csv("Wind Farm A\\datasets\\3.csv", parse_dates=True, sep=";")
df10 = pd.read_csv("Wind Farm A\\datasets\\10.csv", parse_dates=True, sep=";")
df17 = pd.read_csv("Wind Farm A\\datasets\\17.csv", parse_dates=True, sep=";")
df40 = pd.read_csv("Wind Farm A\\datasets\\40.csv", parse_dates=True, sep=";")
df42 = pd.read_csv("Wind Farm A\\datasets\\42.csv", parse_dates=True, sep=";")

#label the datasets with their respective event_id
df3_labeled = df3.copy()
df3_labeled['event_id'] = 3
df10_labeled = df10.copy()
df10_labeled['event_id'] = 10
df17_labeled = df17.copy()
df17_labeled['event_id'] = 17
df40_labeled = df40.copy()
df40_labeled['event_id'] = 40
df42_labeled = df42.copy()
df42_labeled['event_id'] = 42

df_t10 = pd.concat([df3_labeled, df10_labeled, df17_labeled, df40_labeled, df42_labeled], ignore_index=True)



df_t10.to_csv("Wind Farm A\\turbine_data\\t10.csv", index=False, sep=";")

