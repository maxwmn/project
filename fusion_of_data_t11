df_t11 = pd.concat([df25, df68, df69, df92], ignore_index=True)


df_t11_sorted = df_t11.sort_values(by="time_stamp")
df_t11_sorted.to_csv("Wind Farm A\\datasets\\t11_sorted.csv", index=False, sep=";")
