import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

#the datasets 25, 68, 69 and 92 are the datasets for the turbine with asset_id = 11.

df25 = pd.read_csv("Wind Farm A\\datasets\\25.csv", parse_dates=True, sep=";")
