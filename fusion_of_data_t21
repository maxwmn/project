df_t21 = pd.concat([df13, df22, df51, df72], ignore_index=True)


df_t21_sorted = df_t21.sort_values(by="time_stamp")
df_t21_sorted.to_csv("Wind Farm A\\datasets\\t21_sorted.csv", index=False, sep=";")
df_t21.to_csv("Wind Farm A\\datasets\\t21.csv", index=False, sep=";")

