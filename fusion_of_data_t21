import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

#the datasets 13, 22, 51 and 72 are the datasets for the turbine with asset_id = 21.

df13 = pd.read_csv("Wind Farm A\\datasets\\13.csv", parse_dates=True, sep=";")
df22 = pd.read_csv("Wind Farm A\\datasets\\22.csv", parse_dates=True, sep=";")
df51 = pd.read_csv("Wind Farm A\\datasets\\51.csv", parse_dates=True, sep=";")
